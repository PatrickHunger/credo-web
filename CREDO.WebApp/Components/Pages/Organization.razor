@page "/organization"
@layout PublicLayout
@inject IApplicationStringLocalizer T

<PageTitle>@T["Organization.PageTitle"]</PageTitle>

<div class="public-page">
    <section class="public-section">
        <div class="public-section__grid">
            <div>
                <h1 class="public-section__title">@T["Organization.Title"]</h1>

                <div class="public-section__text">
                    <p>@T["Organization.Paragraph1"]</p>
                    <p>@T["Organization.Paragraph2"]</p>
                    <p>@T["Organization.Paragraph3"]</p>
                </div>
            </div>

            <div class="public-section__image" aria-label="@T["Shared.OrganizationImageAlt"]"></div>
        </div>
    </section>

    <section class="public-section">
        <div class="public-values">
            <article class="public-value-card">
                <div class="public-value-card__icon">&#9679;</div>
                <h3>@T["Organization.Identity.Title"]</h3>
                <p>@T["Organization.Identity.Text"]</p>
            </article>

            <article class="public-value-card">
                <div class="public-value-card__icon">&#8982;</div>
                <h3>@T["Organization.Structure.Title"]</h3>
                <p>@T["Organization.Structure.Text"]</p>
            </article>

            <article class="public-value-card">
                <div class="public-value-card__icon">&#9733;</div>
                <h3>@T["Organization.Standards.Title"]</h3>
                <p>@T["Organization.Standards.Text"]</p>
            </article>
        </div>
    </section>

    <section class="public-section">
        <div class="public-section__grid">
            <div>
                <h2 class="public-section__title">@T["Organization.Joining.Title"]</h2>

                <div class="public-section__text">
                    <p>@T["Organization.Joining.Text"]</p>
                </div>
            </div>

            <div class="public-section__text">
                <div class="public-hero__actions">
                    <a class="credo-button credo-button-primary" href="/join-us">
                        @T["Organization.Joining.JoinUs"]
                        <span>&rsaquo;</span>
                    </a>

                    <a class="credo-button credo-button-ghost" href="/contact">
                        @T["Organization.Joining.Contact"]
                        <span>&rsaquo;</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

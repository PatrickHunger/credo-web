@page "/"
@layout PublicLayout
@inject IApplicationStringLocalizer T

<PageTitle>@T["Home.PageTitle"]</PageTitle>

<div class="public-home">
    <section class="public-hero" aria-labelledby="home-hero-title">
        <div class="public-hero__inner">
            <div class="public-hero__content">
                <div class="public-hero__eyebrow">@T["Home.Hero.Eyebrow"]</div>

                <h1 id="home-hero-title" class="public-hero__title">C.R.E.D.O.</h1>

                <div class="public-hero__copy">
                    <p class="public-hero__lead">
                        <strong>@T["Home.Hero.Lead"]</strong>
                    </p>

                    <p>@T["Home.Hero.Connection"]</p>

                    <p>@T["Home.Hero.CollectiveStrength"]</p>
                </div>

                <div class="public-hero__actions">
                    <a class="credo-button credo-button-primary" href="/organization">
                        @T["Home.Hero.ExploreOrganization"]
                        <span>&rsaquo;</span>
                    </a>

                    <a class="credo-button credo-button-ghost" href="/join-us">
                        @T["Home.Hero.JoinOrganization"]
                        <span>&rsaquo;</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="public-section">
        <div class="public-section__grid">
            <div>
                <h2 class="public-section__title">@T["Home.Organization.Title"]</h2>

                <div class="public-section__text">
                    <p>@T["Home.Organization.Paragraph1"]</p>
                    <p>@T["Home.Organization.Paragraph2"]</p>
                    <p>@T["Home.Organization.Paragraph3"]</p>
                </div>
            </div>

            <div class="public-section__image" aria-label="@T["Shared.OrganizationImageAlt"]"></div>
        </div>
    </section>

    <section class="public-section">
        <div class="public-values">
            <article class="public-value-card">
                <div class="public-value-card__icon">&#9679;</div>
                <h3>@T["Home.Values.Community.Title"]</h3>
                <p>@T["Home.Values.Community.Text"]</p>
            </article>

            <article class="public-value-card">
                <div class="public-value-card__icon">&#8982;</div>
                <h3>@T["Home.Values.Operations.Title"]</h3>
                <p>@T["Home.Values.Operations.Text"]</p>
            </article>

            <article class="public-value-card">
                <div class="public-value-card__icon">&#9733;</div>
                <h3>@T["Home.Values.Excellence.Title"]</h3>
                <p>@T["Home.Values.Excellence.Text"]</p>
            </article>
        </div>
    </section>
</div>

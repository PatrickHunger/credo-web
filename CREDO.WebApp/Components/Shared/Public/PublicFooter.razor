@inject IApplicationStringLocalizer T

<footer class="public-footer">
    <div class="public-footer__inner">
        <div class="public-footer__brand">
            <span class="public-footer__logo" aria-hidden="true"></span>
            <div>
                <strong>C.R.E.D.O.</strong><br />
                @T["Shared.BrandSubtitleFull"]
            </div>
        </div>

        <div>
            &copy; @DateTime.Now.Year C.R.E.D.O. @T["Footer.Rights"]
        </div>

        <nav class="public-footer__links" aria-label="@T["Footer.Nav.AriaLabel"]">
            <a href="/contact">@T["Footer.Contact"]</a>
            <span aria-hidden="true">&middot;</span>
            <a href="/join-us">@T["Footer.JoinUs"]</a>
        </nav>
    </div>
</footer>
